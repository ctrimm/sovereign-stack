---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, jsonLd } = Astro.props;
const siteName = "Sovereign Stack";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://sovereignstack.co").toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="sticky top-3 z-20">
      <div class="mx-auto max-w-5xl px-4">
        <div class="flex items-center justify-between gap-2 rounded-full border-2 border-ink bg-cream py-2 pl-4 pr-2 shadow-hard-sm">
          <a href="/" class="flex items-center gap-2 text-lg font-black tracking-tight" aria-label="Sovereign Stack home">
            <img src="/favicon.svg" alt="" width="30" height="30" aria-hidden="true" />
            <span class="hidden sm:inline">Sovereign Stack</span>
            <span class="sm:hidden">Sovereign</span>
          </a>
          <nav aria-label="Primary">
            <ul class="flex items-center gap-1 text-sm font-semibold">
              <li><a href="/categories/" class="rounded-full px-3 py-2 hover:bg-paper">Categories</a></li>
              <li><a href="/alternatives/" class="rounded-full px-3 py-2 hover:bg-paper">Alternatives</a></li>
              <li><a href="/jurisdictions/" class="rounded-full px-3 py-2 hover:bg-paper">Jurisdictions</a></li>
              <li><a href="/insights/" class="rounded-full px-3 py-2 hover:bg-paper">Insights</a></li>
              <li><a href="/submit/" class="rounded-full px-3 py-2 hover:bg-paper">Submit</a></li>
              <li><a href="/about/" class="rounded-full px-3 py-2 hover:bg-paper">About</a></li>
              <li><a href="/advertise/" class="rounded-full border-2 border-ink bg-lime px-4 py-1.5 hover:brightness-95">Advertise</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="mt-20 pb-12">
      <div class="mx-auto max-w-5xl px-4 text-sm text-ink-soft">
        <p class="text-base font-black text-ink">Sovereign Stack</p>
        <p class="mt-2 max-w-2xl">
          A curated directory of sovereign technology: self-hostable software,
          independently-domiciled services, and open hardware — organized by
          jurisdiction, so you can choose whose laws govern your data.
        </p>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-semibold">
          <a href="/about/" class="underline hover:text-ink">Methodology &amp; advertising policy</a>
          <a href="/advertise/" class="underline hover:text-ink">Advertise</a>
          <a href="/submit/" class="underline hover:text-ink">Submit a listing</a>
          <a href="/llms.txt" class="underline hover:text-ink">llms.txt</a>
          <a href="/api/listings.json" class="underline hover:text-ink">API</a>
        </p>
      </div>
    </footer>
  </body>
</html>
