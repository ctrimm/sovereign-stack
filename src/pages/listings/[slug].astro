---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { countryName } from "../../lib/format";

export async function getStaticPaths() {
  const listings = await getCollection("listings");
  const categories = await getCollection("categories");
  const catById = new Map(categories.map((c) => [c.id, c.data]));
  return listings.map((listing) => ({
    params: { slug: listing.id },
    props: { listing, catById },
  }));
}

const { listing, catById } = Astro.props;
const d = listing.data;
const { Content } = await render(listing);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: d.title,
  description: d.tagline,
  url: d.website,
  applicationCategory: d.categories.map((id) => catById.get(id)?.title ?? id).join(", "),
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  ...(d.openSource ? { license: d.license } : {}),
};
---

<Base title={d.title} description={`${d.title}: ${d.tagline}`} jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-4 py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-stone-500">
      <a href="/categories/" class="hover:underline">Categories</a>
      <span aria-hidden="true"> / </span>
      <a href={`/categories/${d.categories[0]}/`} class="hover:underline">
        {catById.get(d.categories[0])?.title ?? d.categories[0]}
      </a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{d.title}</span>
    </nav>

    <h1 class="mt-2 text-4xl font-semibold tracking-tight">{d.title}</h1>
    <p class="mt-3 text-lg text-stone-600">{d.tagline}</p>

    <dl class="mt-8 grid grid-cols-1 gap-4 rounded-xl border border-stone-200 bg-white p-6 shadow-sm sm:grid-cols-2">
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Company</dt>
        <dd class="mt-1 font-medium">{d.company.name} ({countryName(d.company.domicile)}{d.company.founded ? `, founded ${d.company.founded}` : ""})</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Website</dt>
        <dd class="mt-1"><a href={d.website} rel="noopener" class="font-medium text-indigo-700 underline hover:text-indigo-900">{new URL(d.website).hostname}</a></dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">License</dt>
        <dd class="mt-1">{d.license}{d.openSource ? " — open source" : ""}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Pricing</dt>
        <dd class="mt-1">{d.pricing}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Data residency</dt>
        <dd class="mt-1">{d.dataResidency.length > 0 ? d.dataResidency.map(countryName).join(", ") : "Your own infrastructure (self-hosted)"}</dd>
      </div>
      <div>
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Deployment</dt>
        <dd class="mt-1">{[d.selfHost ? "Self-hostable" : null, d.managed ? "Managed hosting" : null].filter(Boolean).join(" · ")}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Legal posture</dt>
        <dd class="mt-1">{d.gdpr}</dd>
      </div>
      {d.replaces.length > 0 && (
        <div class="sm:col-span-2">
          <dt class="text-xs font-medium uppercase tracking-wide text-stone-500">Replaces</dt>
          <dd class="mt-1">{d.replaces.join(", ")}</dd>
        </div>
      )}
    </dl>

    <div class="prose mt-8 max-w-none text-stone-700">
      <Content />
    </div>
  </div>
</Base>
