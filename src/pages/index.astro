---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ListingCard from "../components/ListingCard.astro";
import SearchBox from "../components/SearchBox.astro";
import EmailCapture from "../components/EmailCapture.astro";
import SponsorStrip from "../components/SponsorStrip.astro";
import Ticker from "../components/Ticker.astro";
import { categoryDot } from "../lib/categories";

const categories = await getCollection("categories");
const listings = await getCollection("listings");
const featured = listings.filter((l) => l.data.featured && !l.data.sponsored);
const sponsors = listings.filter((l) => l.data.sponsored);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Sovereign Stack",
  description:
    "A curated directory of sovereign technology: self-hostable software, independently-domiciled services, and open hardware, organized by jurisdiction.",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://sovereignstack.co/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="Sovereign Stack"
  description="A curated directory of sovereign technology: self-hostable software, independently-domiciled services, and open hardware — organized by jurisdiction, so you can choose whose laws govern your data."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <section class="pb-10 pt-14 text-center sm:pt-20">
      <div class="flex flex-wrap justify-center gap-3" aria-hidden="true">
        <span class="rotate-[-4deg] rounded-full border-2 border-ink bg-lime px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">Open source</span>
        <span class="rotate-[3deg] rounded-full border-2 border-ink bg-sky px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">Self-hostable</span>
        <span class="rotate-[-2deg] rounded-full border-2 border-ink bg-amber px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">EU + US + beyond</span>
      </div>
      <h1 class="mx-auto mt-8 max-w-4xl text-5xl font-black leading-[1.02] tracking-tight sm:text-7xl">
        Choose whose <span class="hl-coral">laws</span> govern your <span class="hl-sky">data</span>.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">
        A curated directory of sovereign technology — open source, self-hostable,
        and independently-domiciled products from every continent, organized by
        jurisdiction.
      </p>
      <div class="mx-auto mt-8 max-w-2xl text-left">
        <SearchBox />
      </div>
      <p class="mt-4 text-sm font-semibold text-ink-faint">
        {listings.length} products across {categories.length} categories and counting.
      </p>
    </section>
  </div>

  <Ticker />

  <div class="mx-auto max-w-5xl px-4">
    <section aria-labelledby="categories-heading" class="pt-14">
      <div class="flex items-center gap-3">
        <h2 id="categories-heading" class="text-3xl font-black tracking-tight">Browse by category</h2>
        <span class="rounded-full bg-ink px-3 py-1 text-[13px] font-extrabold text-cream">{categories.length}</span>
      </div>
      <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <li>
            <a
              href={`/categories/${c.id}/`}
              class="block h-full rounded-[20px] border-2 border-ink bg-cream p-6 shadow-hard transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg"
            >
              <span class:list={["block h-4 w-4 rounded-full border-2 border-ink", categoryDot(c.id)]} aria-hidden="true"></span>
              <span class="mt-4 block text-lg font-extrabold tracking-tight">{c.data.title}</span>
              <span class="mt-2 block text-sm leading-relaxed text-ink-soft">{c.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {sponsors.length > 0 && (
      <section aria-labelledby="sponsored-heading" class="pt-14">
        <div class="flex flex-wrap items-center gap-3">
          <h2 id="sponsored-heading" class="text-3xl font-black tracking-tight">Sponsored spotlight</h2>
          <span class="rotate-2 rounded-full border-2 border-ink bg-amber px-3 py-1 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">Paid placement</span>
          <span class="rounded-full border-2 border-ink bg-cream px-3 py-1 text-xs font-extrabold">{3 - sponsors.length} of 3 slots left</span>
        </div>
        <p class="mt-2 text-sm text-ink-soft">Sponsors keep the directory free. Rankings are editorial — never for sale.</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          {sponsors.map((l) => (
            <ListingCard listing={l} />
          ))}
        </div>
      </section>
    )}

    {featured.length > 0 && (
      <section aria-labelledby="featured-heading" class="pt-14">
        <div class="flex items-center gap-3">
          <h2 id="featured-heading" class="text-3xl font-black tracking-tight">Featured</h2>
          <span class="rounded-full bg-ink px-3 py-1 text-[13px] font-extrabold text-cream">staff picks</span>
        </div>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((l) => (
            <ListingCard listing={l} />
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="jurisdiction-heading" class="mt-14 rounded-3xl border-2 border-ink bg-ink p-8 text-cream shadow-hard-lg sm:p-10">
      <h2 id="jurisdiction-heading" class="text-3xl font-black tracking-tight">
        Sovereignty is <span class="text-lime">relative to you</span>
      </h2>
      <p class="mt-4 max-w-3xl leading-relaxed text-cream/80">
        There is no single "sovereign" product. A German company wants EU
        domicile and GDPR-native tooling. A Brazilian buyer may want options
        outside US jurisdiction entirely. Every listing here records company
        domicile, data residency, license, and self-hosting options — so you can
        filter by what sovereignty means for your jurisdiction.
      </p>
      <p class="mt-5">
        <a href="/about/" class="font-bold text-amber underline hover:text-lime">
          Read our methodology and advertising policy →
        </a>
      </p>
    </section>

    <SponsorStrip sponsors={sponsors} />

    <div class="pt-14">
      <EmailCapture />
    </div>
  </div>
</Base>
