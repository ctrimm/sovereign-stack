---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import ListingCard from "../components/ListingCard.astro";
import SearchBox from "../components/SearchBox.astro";
import EmailCapture from "../components/EmailCapture.astro";

const categories = await getCollection("categories");
const listings = await getCollection("listings");
const featured = listings.filter((l) => l.data.featured);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Sovereign Stack",
  description:
    "A curated directory of sovereign technology: self-hostable software, independently-domiciled services, and open hardware, organized by jurisdiction.",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://sovereignstack.co/?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
};
---

<Base
  title="Sovereign Stack"
  description="A curated directory of sovereign technology: self-hostable software, independently-domiciled services, and open hardware — organized by jurisdiction, so you can choose whose laws govern your data."
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-5xl px-4">
    <section class="py-12 sm:py-16">
      <h1 class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-5xl">
        Choose whose laws govern your data.
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-stone-600">
        A curated directory of sovereign technology — open source, self-hostable,
        and independently-domiciled products from every continent, organized by
        jurisdiction.
      </p>
      <div class="mt-8 max-w-2xl">
        <SearchBox />
      </div>
      <p class="mt-3 text-sm text-stone-500">
        {listings.length} products across {categories.length} categories and counting.
      </p>
    </section>

    <section aria-labelledby="categories-heading" class="py-8">
      <h2 id="categories-heading" class="text-2xl font-semibold tracking-tight">Browse by category</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((c) => (
          <li>
            <a
              href={`/categories/${c.id}/`}
              class="block h-full rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
            >
              <span class="font-medium">{c.data.title}</span>
              <span class="mt-1 block text-sm text-stone-600">{c.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    {featured.length > 0 && (
      <section aria-labelledby="featured-heading" class="py-8">
        <h2 id="featured-heading" class="text-2xl font-semibold tracking-tight">Featured</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {featured.map((l) => (
            <ListingCard listing={l} />
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="jurisdiction-heading" class="py-8">
      <h2 id="jurisdiction-heading" class="text-2xl font-semibold tracking-tight">
        Sovereignty is relative to you
      </h2>
      <div class="mt-4 max-w-3xl space-y-3 text-stone-600">
        <p>
          There is no single "sovereign" product. A German company wants EU
          domicile and GDPR-native tooling. A Brazilian buyer may want options
          outside US jurisdiction entirely. Every listing here records company
          domicile, data residency, license, and self-hosting options — so you
          can filter by what sovereignty means for your jurisdiction.
        </p>
        <p>
          <a href="/about/" class="font-medium text-indigo-700 underline hover:text-indigo-900">
            Read our methodology and advertising policy
          </a>
        </p>
      </div>
    </section>

    <div class="py-8">
      <EmailCapture />
    </div>
  </div>
</Base>
