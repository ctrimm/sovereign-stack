---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="The page you are looking for does not exist on Sovereign Stack."
>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">Not found</h1>
    <p class="mt-3 text-stone-600">
      This page does not exist. Try the directory instead.
    </p>
    <p class="mt-6">
      <a
        href="/"
        class="rounded-lg bg-indigo-700 px-5 py-2.5 text-sm font-medium text-white hover:bg-indigo-600"
      >
        Back to the directory
      </a>
    </p>
  </div>
</Base>
