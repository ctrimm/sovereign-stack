---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found"
  description="The page you are looking for does not exist on Sovereign Stack."
>
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <span class="inline-block rotate-[-3deg] rounded-full border-2 border-ink bg-pink px-4 py-1.5 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">
      404
    </span>
    <h1 class="mt-6 text-5xl font-black tracking-tight">Lost in the stack.</h1>
    <p class="mx-auto mt-4 max-w-md text-ink-soft">
      This page doesn't exist — but plenty of sovereign alternatives do.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-block rounded-full border-2 border-ink bg-ink px-8 py-3.5 font-extrabold text-cream shadow-hard hover:bg-black"
      >
        Back to the directory
      </a>
    </p>
  </div>
</Base>
