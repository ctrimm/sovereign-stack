---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Ticker from "../../components/Ticker.astro";
import { slugify } from "../../lib/format";

const listings = await getCollection("listings");
const map = new Map<string, number>();
for (const l of listings) {
  for (const r of l.data.replaces) {
    map.set(r, (map.get(r) ?? 0) + 1);
  }
}
const entries = [...map.entries()].sort((a, b) => b[1] - a[1]);
---

<Base
  title="Sovereign alternatives to popular software | Sovereign Stack"
  description="Browse every product by what it replaces: sovereign alternatives to Gmail, AWS, Google Analytics, Slack, and more."
>
  <Ticker />
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <header class="max-w-3xl">
      <p class="badge">Ditch X, try Y</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">Alternatives</h1>
      <p class="mt-4 text-lg text-ink-soft">
        Every product in the directory, organized by what it replaces. Pick the
        incumbent you want to leave, and compare sovereign options side by side.
      </p>
    </header>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {entries.map(([name, count]) => (
        <li>
          <a
            href={`/alternatives/${slugify(name)}/`}
            class="sticker flex items-center justify-between gap-3 p-5 transition-transform hover:-translate-y-1"
          >
            <span>
              <span class="block font-extrabold">Ditch {name}</span>
              <span class="text-sm text-ink-soft">
                {count} sovereign {count === 1 ? "option" : "options"}
              </span>
            </span>
            <span aria-hidden="true" class="text-xl font-black">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
