---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ListingCard from "../../components/ListingCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import Ticker from "../../components/Ticker.astro";
import { slugify, countryName, EU_COUNTRIES, residencyLabel } from "../../lib/format";

export async function getStaticPaths() {
  const listings = await getCollection("listings");
  const map = new Map<string, { name: string; items: typeof listings }>();
  for (const l of listings) {
    for (const r of l.data.replaces) {
      const slug = slugify(r);
      if (!map.has(slug)) map.set(slug, { name: r, items: [] });
      map.get(slug)!.items.push(l);
    }
  }
  return [...map.entries()].map(([slug, v]) => ({
    params: { slug },
    props: { name: v.name, items: v.items },
  }));
}

const { name, items } = Astro.props;
const domiciles = [...new Set(items.map((l) => l.data.company.domicile))];
const pageTitle = `Sovereign alternatives to ${name}`;
const pageDesc = `Compare ${items.length} sovereign ${items.length === 1 ? "product" : "products"} that replace ${name}: company domicile, data residency, license, and pricing.`;

const openSource = items.filter((l) => l.data.openSource);
const eu = items.filter((l) => EU_COUNTRIES.has(l.data.company.domicile));
const topNames = items.slice(0, 3).map((l) => l.data.title);

const faqs: Array<[string, string]> = [
  [
    `What is the best sovereign alternative to ${name}?`,
    `The most established sovereign options catalogued here are ${topNames.join(", ")}. The right pick depends on your jurisdiction: check each product's company domicile and data residency below, and prefer open-source or self-hostable options when your threat model demands it.`,
  ],
  [
    `Are there open-source alternatives to ${name}?`,
    openSource.length > 0
      ? `Yes: ${openSource.map((l) => l.data.title).join(", ")}.`
      : `None catalogued yet. Sovereign Stack tracks open-source status for every listing, and this page updates as new options are added.`,
  ],
  [
    `Which ${name} alternatives are based in the EU?`,
    eu.length > 0
      ? `EU-domiciled options include ${eu.map((l) => `${l.data.title} (${countryName(l.data.company.domicile)})`).join(", ")}.`
      : `None catalogued yet. This page tracks company domicile for every listing and updates as new options are added.`,
  ],
];

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: pageTitle,
  description: pageDesc,
  numberOfItems: items.length,
  itemListElement: items.map((l, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `https://sovereignstack.co/listings/${l.id}/`,
    name: l.data.title,
  })),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({
    "@type": "Question",
    name: q,
    acceptedAnswer: { "@type": "Answer", text: a },
  })),
};
---

<Base title={`${pageTitle} | Sovereign Stack`} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Ticker />
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm">
      <ol class="flex flex-wrap items-center gap-2 text-ink-soft">
        <li><a href="/" class="underline decoration-wavy underline-offset-4 hover:text-ink">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/alternatives/" class="underline decoration-wavy underline-offset-4 hover:text-ink">Alternatives</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-bold text-ink">{name}</li>
      </ol>
    </nav>

    <header class="max-w-3xl">
      <p class="badge">Ditch {name}</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl">
        Sovereign alternatives to <span class="underline decoration-amber decoration-4 underline-offset-8">{name}</span>
      </h1>
      <p class="mt-4 text-lg text-ink-soft">
        {items.length} {items.length === 1 ? "product" : "products"} that replace {name} — compared by
        company domicile, data residency, license, and pricing. Sovereignty is relative to the buyer:
        pick the jurisdiction that fits your threat model.
      </p>
    </header>

    <FilterBar domiciles={domiciles} total={items.length} />

    <div id="filterable">
    <section aria-label={`Comparison of ${name} alternatives`} class="mt-10 overflow-x-auto rounded-[20px] border-2 border-ink bg-cream shadow-hard">
      <table class="w-full min-w-[760px] text-left text-sm">
        <caption class="sr-only">{pageTitle} comparison</caption>
        <thead>
          <tr class="border-b-2 border-ink text-xs uppercase tracking-wider text-ink-faint">
            <th scope="col" class="px-5 py-4 font-extrabold">Product</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Domicile</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Data residency</th>
            <th scope="col" class="px-5 py-4 font-extrabold">License</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Open source</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Pricing</th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-paper">
          {items.map((l) => (
            <tr
              data-id={l.id}
              class={l.data.sponsored ? "bg-amber/15" : undefined}
              data-filter-item
              data-domicile={l.data.company.domicile}
              data-open={l.data.openSource ? "true" : "false"}
              data-selfhost={l.data.selfHost ? "true" : "false"}
              data-pricing={l.data.pricing}
            >
              <th scope="row" class="px-5 py-4 font-extrabold">
                <a href={`/listings/${l.id}/`} class="underline decoration-wavy decoration-2 underline-offset-4 hover:text-ink-soft">
                  {l.data.title}
                </a>
                {l.data.sponsored && <span class="badge ml-2 bg-amber text-[10px]">Sponsored</span>}
              </th>
              <td class="px-5 py-4">{countryName(l.data.company.domicile)}</td>
              <td class="px-5 py-4">{residencyLabel(l.data)}</td>
              <td class="px-5 py-4">{l.data.license}</td>
              <td class="px-5 py-4">{l.data.openSource ? "Yes" : "No"}</td>
              <td class="px-5 py-4">{l.data.pricing}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section aria-label="All alternatives" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((l) => (
        <div data-id={l.id}
          data-filter-item
          data-domicile={l.data.company.domicile}
          data-open={l.data.openSource ? "true" : "false"}
          data-selfhost={l.data.selfHost ? "true" : "false"}
          data-pricing={l.data.pricing}
        >
          <ListingCard listing={l} />
        </div>
      ))}
    </section>
    <p data-filter-empty hidden class="mt-10 rounded-[20px] border-2 border-dashed border-ink/40 p-6 text-center font-bold text-ink-soft">
      No alternatives match those filters. Try widening the jurisdiction or clearing a checkbox.
    </p>
    </div>

    <section aria-labelledby="faq-heading" class="mt-14 max-w-3xl">
      <h2 id="faq-heading" class="text-2xl font-black tracking-tight">Frequently asked questions</h2>
      <div class="mt-4 space-y-3">
        {faqs.map(([q, a]) => (
          <details class="rounded-[16px] border-2 border-ink bg-cream px-5 py-4 shadow-hard">
            <summary class="cursor-pointer font-extrabold">{q}</summary>
            <p class="mt-2 text-ink-soft">{a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</Base>
