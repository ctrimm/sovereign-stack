---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { categoryDot } from "../../lib/categories";

const categories = await getCollection("categories");
const listings = await getCollection("listings");
const countFor = (id: string) => listings.filter((l) => l.data.categories.includes(id)).length;
---

<Base
  title="Categories"
  description="Browse sovereign technology by category: email, file storage, cloud hosting, analytics, office productivity, networking."
>
  <div class="mx-auto max-w-5xl px-4 pb-8 pt-14">
    <h1 class="text-5xl font-black tracking-tight">Categories</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">Every category is a comparison table — domicile, license, and data residency side by side.</p>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li>
          <a
            href={`/categories/${c.id}/`}
            class="block h-full rounded-[20px] border-2 border-ink bg-cream p-6 shadow-hard transition-all hover:-translate-x-0.5 hover:-translate-y-0.5 hover:shadow-hard-lg"
          >
            <span class:list={["block h-4 w-4 rounded-full border-2 border-ink", categoryDot(c.id)]} aria-hidden="true"></span>
            <span class="mt-4 block text-lg font-extrabold tracking-tight">{c.data.title}</span>
            <span class="mt-2 block text-sm leading-relaxed text-ink-soft">{c.data.description}</span>
            <span class="mt-4 inline-block rounded-full bg-ink px-3 py-1 text-xs font-extrabold text-cream">
              {countFor(c.id)} product{countFor(c.id) === 1 ? "" : "s"}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
