---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const categories = await getCollection("categories");
const listings = await getCollection("listings");
const countFor = (id: string) => listings.filter((l) => l.data.categories.includes(id)).length;
---

<Base
  title="Categories"
  description="Browse sovereign technology by category: email, file storage, cloud hosting, analytics, office productivity, networking."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-semibold tracking-tight">Categories</h1>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((c) => (
        <li>
          <a
            href={`/categories/${c.id}/`}
            class="block h-full rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md"
          >
            <span class="font-medium">{c.data.title}</span>
            <span class="mt-1 block text-sm text-stone-600">{c.data.description}</span>
            <span class="mt-3 block text-xs font-medium text-stone-500">
              {countFor(c.id)} product{countFor(c.id) === 1 ? "" : "s"}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
