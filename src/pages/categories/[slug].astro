---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ListingCard from "../../components/ListingCard.astro";
import { countryName } from "../../lib/format";

export async function getStaticPaths() {
  const categories = await getCollection("categories");
  const listings = await getCollection("listings");
  return categories.map((category) => ({
    params: { slug: category.id },
    props: {
      category,
      items: listings.filter((l) => l.data.categories.includes(category.id)),
    },
  }));
}

const { category, items } = Astro.props;
const c = category.data;
const sponsors = items.filter((l) => l.data.sponsored);
const editorial = items.filter((l) => !l.data.sponsored);
const ordered = [...sponsors, ...editorial];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `${c.title} — Sovereign Stack`,
  description: c.description,
  itemListElement: ordered.map((l, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: l.data.title,
    url: `https://sovereignstack.co/listings/${l.id}/`,
  })),
};
---

<Base title={c.title} description={c.description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 pb-8 pt-14">
    <nav aria-label="Breadcrumb" class="text-sm font-semibold text-ink-faint">
      <a href="/categories/" class="hover:text-ink hover:underline">Categories</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page" class="text-ink">{c.title}</span>
    </nav>
    <h1 class="mt-3 text-5xl font-black tracking-tight">{c.title}</h1>
    <p class="mt-3 max-w-2xl text-lg text-ink-soft">{c.description}</p>

    {sponsors.length > 0 && (
      <aside aria-label="Sponsored spotlight" class="mt-8 rounded-[20px] border-2 border-ink bg-amber/25 p-6 shadow-hard">
        <span class="inline-block rotate-[-2deg] rounded-full border-2 border-ink bg-amber px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider shadow-hard-sm">Sponsored</span>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {sponsors.map((l) => (
            <div class="rounded-2xl border-2 border-ink bg-cream p-5">
              <p class="text-lg font-extrabold"><a href={`/listings/${l.id}/`} class="hover:underline">{l.data.title}</a></p>
              <p class="mt-1 text-sm text-ink-soft">{l.data.tagline}</p>
              <p class="mt-3"><a href={l.data.website} rel="sponsored noopener" class="inline-block rounded-full border-2 border-ink bg-ink px-4 py-1.5 text-sm font-bold text-cream hover:bg-black">Visit site →</a></p>
            </div>
          ))}
        </div>
        <p class="mt-4 text-xs text-ink-soft">Paid placement. It never affects the comparison below. <a href="/advertise/" class="font-bold underline">Your product here →</a></p>
      </aside>
    )}
    {sponsors.length === 0 && (
      <aside aria-label="Sponsor this category" class="mt-8 rounded-[20px] border-2 border-dashed border-ink/40 p-5">
        <p class="font-bold">
          Your product here.
          <a href="/advertise/" class="ml-1 underline decoration-wavy underline-offset-4">Sponsor this category →</a>
        </p>
        <p class="mt-1 text-sm text-ink-soft">Only one banner slot per category. When it's gone, it's gone.</p>
      </aside>
    )}

    <h2 class="mt-12 text-2xl font-black tracking-tight">Compare</h2>
    <div class="mt-4 overflow-x-auto rounded-[20px] border-2 border-ink bg-cream shadow-hard">
      <table class="w-full min-w-[760px] text-left text-sm">
        <caption class="sr-only">Comparison of {c.title} products</caption>
        <thead>
          <tr class="border-b-2 border-ink text-xs uppercase tracking-wider text-ink-faint">
            <th scope="col" class="px-5 py-4 font-extrabold">Product</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Domicile</th>
            <th scope="col" class="px-5 py-4 font-extrabold">License</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Self-host</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Data residency</th>
            <th scope="col" class="px-5 py-4 font-extrabold">Pricing</th>
          </tr>
        </thead>
        <tbody class="divide-y-2 divide-paper">
          {ordered.map((l) => (
            <tr class:list={[l.data.sponsored && "bg-amber/15"]}>
              <th scope="row" class="px-5 py-4 font-extrabold">
                <a href={`/listings/${l.id}/`} class="text-coral-deep underline decoration-2 hover:text-ink">{l.data.title}</a>
                {l.data.sponsored && (
                  <span class="ml-2 inline-block rotate-2 rounded-full border-2 border-ink bg-amber px-2 py-0.5 align-middle text-[10px] font-extrabold uppercase tracking-wider">Sponsored</span>
                )}
                <span class="block text-xs font-medium text-ink-soft">{l.data.tagline}</span>
              </th>
              <td class="px-5 py-4">{countryName(l.data.company.domicile)}</td>
              <td class="px-5 py-4">{l.data.openSource ? `${l.data.license} (open)` : l.data.license}</td>
              <td class="px-5 py-4">{l.data.selfHost ? "Yes" : "No"}</td>
              <td class="px-5 py-4">
                {l.data.dataResidency.length > 0
                  ? l.data.dataResidency.map(countryName).join(", ")
                  : "Your infrastructure"}
              </td>
              <td class="px-5 py-4">{l.data.pricing}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2 class="mt-12 text-2xl font-black tracking-tight">All {c.title} listings</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {ordered.map((l) => (
        <ListingCard listing={l} />
      ))}
    </div>
  </div>
</Base>
