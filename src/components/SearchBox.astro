---
// Client-side search over /api/listings.json. No framework, no build step.
interface Props {
  id?: string;
}
const { id = "site-search" } = Astro.props;
---

<form role="search" aria-label="Search the directory" id={`${id}-form`} class="w-full">
  <label for={id} class="sr-only">Search sovereign products</label>
  <div class="flex overflow-hidden rounded-2xl border-2 border-ink bg-cream shadow-hard">
    <input
      id={id}
      name="q"
      type="search"
      autocomplete="off"
      placeholder="Search products, categories, or what they replace…"
      class="w-full bg-transparent px-5 py-4 text-base outline-none placeholder:text-ink-faint"
    />
    <button
      type="submit"
      class="shrink-0 border-l-2 border-ink bg-coral px-7 text-base font-extrabold hover:bg-coral-deep hover:text-cream"
      tabindex="-1"
      aria-hidden="true"
    >
      Search
    </button>
  </div>
  <p id={`${id}-status`} class="sr-only" role="status" aria-live="polite"></p>
  <ul id={`${id}-results`} class="mt-3 hidden divide-y-2 divide-paper overflow-hidden rounded-2xl border-2 border-ink bg-cream shadow-hard"></ul>
</form>

<script define:vars={{ id }}>
  const form = document.getElementById(`${id}-form`);
  const input = document.getElementById(id);
  const results = document.getElementById(`${id}-results`);
  const status = document.getElementById(`${id}-status`);
  let index = null;

  async function loadIndex() {
    if (index) return index;
    const res = await fetch("/api/listings.json");
    index = await res.json();
    return index;
  }

  function matches(item, q) {
    const hay = [item.title, item.tagline, item.company.name, ...(item.replaces || []), ...(item.categories || [])]
      .join(" ")
      .toLowerCase();
    return q
      .toLowerCase()
      .split(/\s+/)
      .every((term) => hay.includes(term));
  }

  form.addEventListener("submit", (e) => e.preventDefault());

  let timer;
  input.addEventListener("input", () => {
    clearTimeout(timer);
    timer = setTimeout(async () => {
      const q = input.value.trim();
      if (q.length < 2) {
        results.classList.add("hidden");
        results.innerHTML = "";
        status.textContent = "";
        return;
      }
      const data = await loadIndex();
      const hits = data.filter((item) => matches(item, q)).slice(0, 8);
      status.textContent = hits.length === 0 ? "No results" : `${hits.length} result${hits.length === 1 ? "" : "s"}`;
      results.innerHTML = hits
        .map(
          (h) =>
            `<li><a href="/listings/${h.slug}/" class="block px-5 py-3.5 hover:bg-paper"><span class="font-extrabold">${h.title}</span>${h.sponsored ? ' <span class="text-xs font-bold uppercase">· Sponsored</span>' : ""}<span class="block text-sm text-ink-soft">${h.tagline}</span></a></li>`
        )
        .join("");
      results.classList.toggle("hidden", hits.length === 0);
    }, 150);
  });
</script>
