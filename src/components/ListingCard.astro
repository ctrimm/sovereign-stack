---
import { countryName } from "../lib/format";
import { cardFlag } from "../lib/categories";
import type { CollectionEntry } from "astro:content";

interface Props {
  listing: CollectionEntry<"listings">;
  /** Rendered on the /advertise page to preview the ad unit. */
  example?: boolean;
}

const { listing, example = false } = Astro.props;
const d = listing.data;
const url = example ? "/advertise/" : `/listings/${listing.id}/`;
const flag = cardFlag(d);
// Sponsored outbound links are disclosed to search engines.
const rel = d.sponsored && !example ? "sponsored noopener" : "noopener";
---

<article
  class:list={[
    "relative rounded-[20px] border-2 border-ink bg-cream p-6 shadow-hard transition-transform hover:-translate-y-1",
    d.sponsored && !example && "bg-amber/15",
  ]}
>
  <span
    class:list={[
      "absolute -top-3.5 right-5 rotate-3 rounded-full border-2 border-ink px-3 py-1 text-[11px] font-extrabold uppercase tracking-wider shadow-hard-sm",
      d.sponsored && !example ? "bg-amber" : "bg-lime",
    ]}
  >
    {example ? "Sponsored (example)" : flag}
  </span>
  <h3 class="text-xl font-black tracking-tight">
    <a href={url} class="hover:underline">{d.title}</a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{d.tagline}</p>
  <div class="mt-4 flex flex-wrap gap-2" aria-label="Key facts">
    <span class="rounded-full border-2 border-ink bg-lime px-3 py-1 text-xs font-bold">{countryName(d.company.domicile)}</span>
    {d.openSource && <span class="rounded-full border-2 border-ink bg-violet px-3 py-1 text-xs font-bold">Open source</span>}
    {d.selfHost && <span class="rounded-full border-2 border-ink bg-cream px-3 py-1 text-xs font-bold">Self-hostable</span>}
    <span class="rounded-full border-2 border-ink bg-paper px-3 py-1 text-xs font-bold">{d.pricing}</span>
  </div>
  {d.replaces.length > 0 && (
    <p class="mt-4 text-[13px] text-ink-faint">
      <strong class="font-bold text-ink-soft">Replaces:</strong> {d.replaces.join(", ")}
    </p>
  )}
  {(d.sponsored || example) && (
    <p class="mt-4">
      <a
        href={example ? "/advertise/" : d.website}
        rel={rel}
        class="inline-block rounded-full border-2 border-ink bg-ink px-5 py-2 text-sm font-bold text-cream hover:bg-black"
      >
        Visit site →
      </a>
    </p>
  )}
</article>
