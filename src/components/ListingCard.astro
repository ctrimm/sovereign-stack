---
import { countryName } from "../lib/format";
import type { CollectionEntry } from "astro:content";

interface Props {
  listing: CollectionEntry<"listings">;
}

const { listing } = Astro.props;
const d = listing.data;
const url = `/listings/${listing.id}/`;
---

<article class="rounded-xl border border-stone-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
  <h3 class="text-lg font-semibold tracking-tight">
    <a href={url} class="hover:underline">{d.title}</a>
  </h3>
  <p class="mt-1 text-sm text-stone-600">{d.tagline}</p>
  <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
    <div class="flex gap-1">
      <dt class="sr-only">Domicile</dt>
      <dd class="rounded-full bg-stone-100 px-2 py-0.5 font-medium">{countryName(d.company.domicile)}</dd>
    </div>
    {d.openSource && (
      <div class="flex gap-1">
        <dt class="sr-only">License</dt>
        <dd class="rounded-full bg-stone-100 px-2 py-0.5 font-medium">Open source</dd>
      </div>
    )}
    {d.selfHost && (
      <div class="flex gap-1">
        <dt class="sr-only">Self-hosting</dt>
        <dd class="rounded-full bg-stone-100 px-2 py-0.5 font-medium">Self-hostable</dd>
      </div>
    )}
    <div class="flex gap-1">
      <dt class="sr-only">Pricing</dt>
      <dd class="rounded-full bg-stone-100 px-2 py-0.5 font-medium">{d.pricing}</dd>
    </div>
  </dl>
  {d.replaces.length > 0 && (
    <p class="mt-3 text-xs text-stone-500">
      Replaces: {d.replaces.join(", ")}
    </p>
  )}
</article>
