---
/**
 * Sponsored media kit: a product gallery with an optional video hero.
 * Main stage + thumbnail column on the right (stacked below on mobile).
 * Video (YouTube/Vimeo allowlist) renders as the first slide and only
 * loads its iframe on click, to keep page weight down.
 */
interface Props {
  productName: string;
  images?: string[];
  videoUrl?: string;
  videoTitle?: string;
  /** Extra label rendered on the frame, e.g. "Example". */
  demoLabel?: string;
}

const { productName, images = [], videoUrl, videoTitle, demoLabel } = Astro.props;

function toEmbed(url: string): string | null {
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\./, "");
    if (host === "youtube.com" || host === "m.youtube.com") {
      const v = u.searchParams.get("v");
      if (v && /^[\w-]{6,}$/.test(v)) return `https://www.youtube-nocookie.com/embed/${v}`;
      const m = u.pathname.match(/^\/(embed|shorts)\/([\w-]{6,})/);
      if (m) return `https://www.youtube-nocookie.com/embed/${m[2]}`;
    }
    if (host === "youtu.be") {
      const id = u.pathname.replace(/^\//, "");
      if (/^[\w-]{6,}$/.test(id)) return `https://www.youtube-nocookie.com/embed/${id}`;
    }
    if (host === "vimeo.com" || host === "player.vimeo.com") {
      const m = u.pathname.match(/\/(\d+)/);
      if (m) return `https://player.vimeo.com/video/${m[1]}`;
    }
    return null;
  } catch {
    return null;
  }
}

const embedUrl = videoUrl ? toEmbed(videoUrl) : null;
const hasVideo = embedUrl !== null;
const slideCount = images.length + (hasVideo ? 1 : 0);
const gid = `mg-${Math.random().toString(36).slice(2, 9)}`;
---

{slideCount > 0 && (
  <figure
    class="media-gallery sticker overflow-hidden"
    data-gallery={gid}
    aria-roledescription="carousel"
    aria-label={`${productName} media gallery`}
  >
    <div class="flex flex-col gap-3 p-3 sm:p-4 lg:flex-row">
      <div class="relative min-w-0 flex-1">
        <div
          class="stage relative aspect-[16/10] overflow-hidden rounded-[14px] border-2 border-ink bg-ink"
          aria-live="polite"
        >
          {hasVideo && (
            <div class="slide absolute inset-0" data-slide="0" role="group" aria-roledescription="slide" aria-label={`1 of ${slideCount}: video`}>
              <button
                type="button"
                class="video-poster group absolute inset-0 flex h-full w-full items-center justify-center bg-ink"
                data-embed={embedUrl}
                data-title={videoTitle ?? `${productName} video`}
                aria-label={`Play video: ${videoTitle ?? productName}`}
              >
                {images[0] ? (
                  <img src={images[0]} alt="" class="absolute inset-0 h-full w-full object-cover opacity-60" loading="lazy" />
                ) : (
                  <span class="absolute inset-0 bg-violet" aria-hidden="true"></span>
                )}
                <span class="relative flex h-20 w-20 items-center justify-center rounded-full border-2 border-ink bg-lime shadow-hard transition-transform group-hover:scale-110" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="absolute bottom-3 left-3 rounded-full border-2 border-ink bg-ink px-3 py-1 text-xs font-extrabold uppercase tracking-wider text-paper">
                  Video
                </span>
              </button>
            </div>
          )}
          {images.map((src, i) => {
            const n = i + (hasVideo ? 1 : 0);
            return (
              <div
                class={`slide absolute inset-0${n === 0 ? "" : " hidden"}`}
                data-slide={n}
                role="group"
                aria-roledescription="slide"
                aria-label={`${n + 1} of ${slideCount}`}
              >
                <img
                  src={src}
                  alt={`${productName} — image ${i + 1}`}
                  class="h-full w-full object-cover"
                  loading={n === 0 ? "eager" : "lazy"}
                />
              </div>
            );
          })}
          {slideCount > 1 && (
            <>
              <button
                type="button"
                class="nav-prev absolute left-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-2 border-ink bg-paper shadow-hard-sm transition-transform hover:scale-105"
                aria-label="Previous image"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
              </button>
              <button
                type="button"
                class="nav-next absolute right-3 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border-2 border-ink bg-paper shadow-hard-sm transition-transform hover:scale-105"
                aria-label="Next image"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
              </button>
            </>
          )}
        </div>
        {demoLabel && (
          <span class="absolute left-5 top-5 rotate-[-2deg] rounded-full border-2 border-ink bg-amber px-3 py-1 text-xs font-extrabold uppercase tracking-wider shadow-hard-sm">
            {demoLabel}
          </span>
        )}
      </div>

      {slideCount > 1 && (
        <div
          class="flex shrink-0 gap-3 overflow-x-auto lg:max-h-[420px] lg:w-28 lg:flex-col lg:overflow-y-auto lg:overflow-x-hidden lg:pr-1"
          role="tablist"
          aria-label="Gallery thumbnails"
        >
          {hasVideo && (
            <button
              type="button"
              role="tab"
              aria-selected="true"
              aria-label="Show video"
              data-thumb="0"
              class="thumb relative aspect-[16/10] w-24 shrink-0 overflow-hidden rounded-xl border-2 border-ink bg-ink lg:w-full"
            >
              <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-lime">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
              </span>
            </button>
          )}
          {images.map((src, i) => {
            const n = i + (hasVideo ? 1 : 0);
            return (
              <button
                type="button"
                role="tab"
                aria-selected={n === 0 ? "true" : "false"}
                aria-label={`Show image ${i + 1}`}
                data-thumb={n}
                class="thumb aspect-[16/10] w-24 shrink-0 overflow-hidden rounded-xl border-2 border-ink bg-paper opacity-60 transition-opacity hover:opacity-100 lg:w-full"
              >
                <img src={src} alt="" class="h-full w-full object-cover" loading="lazy" />
              </button>
            );
          })}
        </div>
      )}
    </div>
    <figcaption class="border-t-2 border-dashed border-ink/20 px-5 py-3 text-xs font-semibold text-ink-soft">
      Media provided by the vendor. Sponsored placement — editorial rankings are unaffected.
    </figcaption>
  </figure>
)}

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((root) => {
    if (root.dataset.bound === "1") return;
    root.dataset.bound = "1";
    const slides = [...root.querySelectorAll<HTMLElement>("[data-slide]")];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>("[data-thumb]")];
    if (slides.length === 0) return;
    let current = 0;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => s.classList.toggle("hidden", i !== current));
      thumbs.forEach((t, i) => {
        t.setAttribute("aria-selected", i === current ? "true" : "false");
        t.classList.toggle("opacity-60", i !== current);
      });
    };

    root.querySelector(".nav-prev")?.addEventListener("click", () => show(current - 1));
    root.querySelector(".nav-next")?.addEventListener("click", () => show(current + 1));
    thumbs.forEach((t) =>
      t.addEventListener("click", () => show(Number(t.dataset.thumb ?? 0)))
    );
    root.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    // Lazy video: swap the poster button for the iframe on click.
    const poster = root.querySelector<HTMLButtonElement>(".video-poster");
    poster?.addEventListener("click", () => {
      const embed = poster.dataset.embed;
      if (!embed) return;
      const frame = document.createElement("iframe");
      frame.src = `${embed}?autoplay=1&rel=0`;
      frame.title = poster.dataset.title ?? "Sponsor video";
      frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      frame.allowFullscreen = true;
      frame.className = "absolute inset-0 h-full w-full";
      frame.setAttribute("loading", "lazy");
      poster.replaceWith(frame);
    }, { once: true });
  });
</script>

<style>
  .media-gallery .thumb[aria-selected="true"] {
    opacity: 1;
    outline: 3px solid var(--color-lime);
    outline-offset: 2px;
  }
</style>
