---
// Day-one email capture. The newsletter launches later; this just collects
// addresses. Set PUBLIC_NEWSLETTER_ENDPOINT to a form endpoint when ready.
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_ENDPOINT;
---

<section aria-labelledby="newsletter-heading" class="rotate-[0.6deg] rounded-3xl border-2 border-ink bg-coral p-8 shadow-hard-lg sm:p-10">
  <h2 id="newsletter-heading" class="text-2xl font-black tracking-tight">
    Get new sovereign listings in your inbox
  </h2>
  <p class="mt-2 max-w-xl font-medium text-ink">
    A short, occasional email when we add new categories and products. No
    newsletter yet — just a heads-up list for launch.
  </p>
  {endpoint ? (
    <form action={endpoint} method="post" class="mt-5 flex max-w-md flex-col gap-3 sm:flex-row">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        required
        placeholder="you@example.com"
        class="w-full rounded-full border-2 border-ink bg-cream px-5 py-3 text-sm font-medium outline-none placeholder:text-ink-faint"
      />
      <button
        type="submit"
        class="shrink-0 rounded-full border-2 border-ink bg-ink px-7 py-3 text-sm font-extrabold text-cream hover:bg-black"
      >
        Notify me
      </button>
    </form>
  ) : (
    <p class="mt-5 inline-block rounded-full border-2 border-ink bg-cream px-5 py-2.5 text-sm font-bold">
      Signup opens soon — check back after launch.
    </p>
  )}
</section>
